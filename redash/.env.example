# Copy this file to redash/.env and replace every CHANGE_ME with your own random text.
# (.env is in .gitignore: never put real secrets on GitHub.)
POSTGRES_PASSWORD=CHANGE_ME_db_password
REDASH_DATABASE_URL=postgresql://postgres:CHANGE_ME_db_password@postgres/postgres
REDASH_REDIS_URL=redis://redis:6379/0
REDASH_COOKIE_SECRET=CHANGE_ME_long_random_text_1
REDASH_SECRET_KEY=CHANGE_ME_long_random_text_2
REDASH_LOG_LEVEL=INFO
